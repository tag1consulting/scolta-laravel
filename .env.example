# Scolta AI Search Configuration
# Copy these to your .env file and customize as needed.

# Site type preset: content_catalog, reference, ecommerce, blog, none
SCOLTA_PRESET=none

# AI Provider: 'anthropic', 'openai', 'amazee', or 'laravel' (Laravel 12+)
SCOLTA_AI_PROVIDER=anthropic

# API key for AI features (query expansion, summarization, follow-ups)
# Required for AI features. Leave empty to disable AI.
SCOLTA_API_KEY=

# AI model identifier
SCOLTA_AI_MODEL=claude-sonnet-4-5-20250929

# Optional separate model for query expansion only (leave empty for single-model)
SCOLTA_EXPANSION_MODEL=

# Custom API base URL (leave empty for provider defaults)
SCOLTA_AI_BASE_URL=

# AI feature toggles
SCOLTA_AI_EXPAND=true
SCOLTA_AI_SUMMARIZE=true

# Offer visitors a switch that turns query expansion off for themselves.
# Only narrows: it can never re-enable expansion a site has turned off.
SCOLTA_EXPANSION_TOGGLE=true
SCOLTA_MAX_FOLLOWUPS=3

# AI response languages (comma-separated ISO 639-1 codes)
SCOLTA_AI_LANGUAGES=en

# Site identity (used in AI prompts)
SCOLTA_SITE_NAME=
SCOLTA_SITE_DESCRIPTION=

# Indexer backend: auto, php, or binary
SCOLTA_INDEXER=auto

# Memory budget profile: conservative, balanced, or aggressive
SCOLTA_MEMORY_BUDGET=conservative

# Pages per chunk (leave empty for profile default)
SCOLTA_CHUNK_SIZE=

# Pagefind binary path (leave empty for auto-detection)
SCOLTA_PAGEFIND_BINARY=

# Build and output directories
SCOLTA_BUILD_DIR=
SCOLTA_OUTPUT_DIR=

# Seconds the scheduled retired-index sweep may spend deleting .scolta-trash-*
# directories before stopping; the next run resumes on what is left. 0 disables
# the scheduled sweep (`php artisan scolta:cleanup` still works by hand).
SCOLTA_CLEANUP_CRON_SECONDS=180

# Auto-rebuild index when content changes (requires queue worker)
SCOLTA_AUTO_REBUILD=true
SCOLTA_AUTO_REBUILD_DELAY=300

# Show "Powered by Scolta" attribution below search widget
SCOLTA_SHOW_ATTRIBUTION=false

# Cache TTL for AI responses in seconds (default: 30 days)
SCOLTA_CACHE_TTL=2592000

# Rate limiting: API requests per minute per IP (0 to disable)
SCOLTA_RATE_LIMIT=30

# Scoring: language for stop word filtering (ISO 639-1 code)
SCOLTA_LANGUAGE=en

# Scoring: comma-separated extra stop words
SCOLTA_CUSTOM_STOP_WORDS=

# Scoring: recency decay strategy (exponential, linear, step, none, custom)
SCOLTA_RECENCY_STRATEGY=exponential

# Scoring: custom recency curve as JSON (for 'custom' strategy)
# Example: SCOLTA_RECENCY_CURVE='[[0,1.0],[180,0.5],[365,0.0]]'
SCOLTA_RECENCY_CURVE=

# Hide facet values with zero results for the current query (default: true).
# Set false to render every value, showing a zero-count one as a disabled "(0)"
# row so the value list stays positionally fixed across queries.
SCOLTA_HIDE_EMPTY_FACETS=true

# Scoring: weight partial matches by how rare each term is in the corpus, so a
# match on a rare intent-bearing term outranks a match on a ubiquitous one.
SCOLTA_SPECIFICITY_WEIGHTING=true

# Scoring: floor for a ubiquitous term's specificity weight (0-1, lower damps harder)
SCOLTA_SPECIFICITY_FLOOR=0.15

# Scoring: specificity at which a match counts as strong and on-intent (0-1)
SCOLTA_SPECIFICITY_STRONG_MATCH=0.55

# Scoring: multiplier on the bonus for agreeing with several query terms at once
# (0-5). Set to 0 to score each result purely by its best-matching sub-query.
SCOLTA_SPECIFICITY_COOCCURRENCE=0.9

# Scoring: specificity a term must clear to count toward the agreement bonus (0-1)
SCOLTA_SPECIFICITY_AGREEMENT_GATE=0.45

# Scoring: geometric factor per successive agreeing term (0-5); below 1 saturates
SCOLTA_SPECIFICITY_AGREEMENT_DECAY=1.0

# Search as you type: suggestions dropdown while typing (default: true). The
# full search still runs only on Enter, on the search button, or on selecting a
# suggestion. Set false to restore the pre-1.1.0 widget exactly.
SCOLTA_SAYT_ENABLED=true

# SAYT: characters typed before suggestions are requested, counted in graphemes
# (CJK sites commonly want 1)
SCOLTA_SAYT_MIN_CHARS=2

# SAYT: trailing debounce in milliseconds before a suggest cycle fires
SCOLTA_SAYT_DEBOUNCE_MS=150

# SAYT: most suggestions shown, and the cap on fragment loads per pass
SCOLTA_SAYT_MAX_SUGGESTIONS=6

# SAYT: offer the visitor's own recent searches, kept in their browser under a
# single localStorage key. false reads and writes nothing.
SCOLTA_SAYT_RECENT_SEARCHES=true

# SAYT: most recent searches shown above the content suggestions
SCOLTA_SAYT_MAX_RECENT=3

# SAYT: enrich suggestions with AI query expansion (inert with no AI configured)
SCOLTA_SAYT_EXPAND=true

# SAYT: expansion calls per visitor per minute. SAYT expansions share the AI
# flood budget with committed searches, so an uncapped suggest path would starve
# the search someone actually ran.
SCOLTA_SAYT_EXPAND_PER_MINUTE=6

# SAYT: idle milliseconds before the AI enrichment call. Longer than the typing
# debounce on purpose: keyword suggestions while typing, AI calls on a pause.
SCOLTA_SAYT_EXPANSION_DELAY_MS=500

# SAYT: what selecting a title suggestion does — navigate or search
SCOLTA_SAYT_SUGGESTION_ACTION=navigate
