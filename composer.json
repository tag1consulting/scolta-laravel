{
    "name": "tag1/scolta-laravel",
    "version": "1.0.1",
    "description": "Scolta AI Search for Laravel \u2014 zero-infrastructure AI-powered search with Pagefind",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "search", "pagefind", "ai", "scolta"],
    "authors": [
        {
            "name": "Tag1 Consulting",
            "homepage": "https://www.tag1.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tag1consulting/scolta-laravel/issues",
        "source": "https://github.com/tag1consulting/scolta-laravel"
    },
    "require": {
        "php": ">=8.1",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "tag1/scolta-php": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --no-progress --memory-limit=256M",
        "validate-release": "php scripts/validate-release.php"
    },
    "autoload": {
        "psr-4": {
            "Tag1\\ScoltaLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tag1\\ScoltaLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Tag1\\ScoltaLaravel\\ScoltaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "_comment": "Development only — local path to scolta-php for symlink installs. Consumers resolve from Packagist.",
            "type": "path",
            "url": "../scolta-php"
        }
    ],
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-5jz8-6tcw-pbk4",
                "PKSA-z3gr-8qht-p93v"
            ]
        }
    }
}
