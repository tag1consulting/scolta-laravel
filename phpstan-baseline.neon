parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Http/Controllers/AmazeeSettingsController.php

		-
			message: '#^Offset ''limit'' does not exist on array\{ok\: false, data\?\: mixed, status\?\: int, error\?\: string\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: tests/ControllerValidationTest.php
