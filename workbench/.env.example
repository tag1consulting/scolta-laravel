# Environment for the workbench testing site (vendor/bin/testbench).
# Copied into the testbench skeleton's .env at startup.

APP_NAME="Scolta Recipes"
# Local testing site only — this key protects nothing.
APP_KEY="base64:4p94vbpSnRPqcYX4ShDm4QRNORDPNUzwoGakmuu+OVo="
APP_ENV=local
APP_DEBUG=true

DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SCOLTA_PRESET=content_catalog
SCOLTA_SITE_NAME="Scolta Recipes"
SCOLTA_SITE_DESCRIPTION="a recipe site with 20 dishes from around the world"

# The sync queue driver would run a full rebuild inline on every seeded row;
# the workbench builds its index once, explicitly, as the last build step.
SCOLTA_AUTO_REBUILD=false

# Set a provider and key to exercise the AI features (expansion, summaries):
# SCOLTA_AI_PROVIDER=anthropic
# SCOLTA_API_KEY=sk-ant-...
